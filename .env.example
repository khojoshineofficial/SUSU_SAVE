# ---------------------------------------------------------------------------
# SUSU SAVE — environment configuration
# Copy to .env and fill in real values. NEVER commit the .env file itself.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
LOG_LEVEL=info

# Database — a local mongod in development, MongoDB Atlas in production
MONGODB_URI=mongodb://127.0.0.1:27017/susu_save
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/susu_save?retryWrites=true&w=majority

# Authentication — generate with: openssl rand -hex 48
# These are REQUIRED in production; the app refuses to boot without them.
JWT_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_ACCESS_TTL=30m
JWT_REFRESH_TTL=30d

# Currency and locale
CURRENCY=GHS
CURRENCY_SYMBOL=GH₵
DEFAULT_COUNTRY=Ghana

# Payments
# `mock` is the built-in development provider. Register a real provider in
# src/services/payment/ and set its name here to go live.
PAYMENT_PROVIDER=mock
PAYMENT_PROVIDER_KEY=
PAYMENT_PROVIDER_SECRET=
PAYMENT_WEBHOOK_SECRET=replace-with-the-secret-your-provider-signs-with

# Email — `console` logs mail instead of sending it, which is fine locally
EMAIL_DRIVER=console
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=SUSU SAVE <no-reply@sususave.app>

# Scheduled jobs
# On a serverless host (Vercel) cron cannot run in-process. Set this secret and
# have the platform call POST /api/jobs/run-daily with it. Generate with:
#   openssl rand -hex 32
CRON_SECRET=

# Platform staff accounts
ADMIN_EMAIL=admin@sususave.app
SUPER_ADMIN_EMAIL=owner@sususave.app

# Staff provisioning for hosts with no shell. Set to "true", deploy, then delete
# this variable. Use "reset" to rotate the username and password of accounts
# that already exist.
BOOTSTRAP_STAFF=

# Optional: choose the staff credentials yourself instead of having them
# generated. Whatever you set here is applied on every bootstrap run, so
# changing a password here and redeploying is a working password reset.
# Usernames are 4-32 characters of letters, numbers, dot, underscore or hyphen;
# passwords must be at least 10 characters. Delete these once you have signed in
# and changed the password from the console.
SUPER_ADMIN_USERNAME=
SUPER_ADMIN_PASSWORD=
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Scheduled jobs — set to false on any instance that should not run cron work
ENABLE_JOBS=true

# CORS — comma-separated origins. Leave empty to allow same-origin requests only.
CORS_ORIGINS=

# Tests — point at a real MongoDB to run the database-backed suites without
# downloading an in-memory server binary.
# MONGODB_TEST_URI=mongodb://127.0.0.1:27017/susu_save_test
