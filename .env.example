# ---------------------------------------------------------------------------
# SUSU SAVE — environment configuration
# Copy to .env and fill in real values. NEVER commit the .env file itself.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
LOG_LEVEL=info

# Database — a local mongod in development, MongoDB Atlas in production
MONGODB_URI=mongodb://127.0.0.1:27017/susu_save
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/susu_save?retryWrites=true&w=majority

# Authentication — generate with: openssl rand -hex 48
# These are REQUIRED in production; the app refuses to boot without them.
JWT_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_ACCESS_TTL=30m
JWT_REFRESH_TTL=30d

# Currency and locale
CURRENCY=GHS
CURRENCY_SYMBOL=GH₵
DEFAULT_COUNTRY=Ghana

# Payments
# `mock` is the built-in development provider. Register a real provider in
# src/services/payment/ and set its name here to go live.
PAYMENT_PROVIDER=mock
PAYMENT_PROVIDER_KEY=
PAYMENT_PROVIDER_SECRET=
PAYMENT_WEBHOOK_SECRET=replace-with-the-secret-your-provider-signs-with

# Email — `console` logs mail instead of sending it, which is fine locally
EMAIL_DRIVER=console
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=SUSU SAVE <no-reply@sususave.app>

# Platform
ADMIN_EMAIL=admin@sususave.app

# Scheduled jobs — set to false on any instance that should not run cron work
ENABLE_JOBS=true

# CORS — comma-separated origins. Leave empty to allow same-origin requests only.
CORS_ORIGINS=

# Tests — point at a real MongoDB to run the database-backed suites without
# downloading an in-memory server binary.
# MONGODB_TEST_URI=mongodb://127.0.0.1:27017/susu_save_test
